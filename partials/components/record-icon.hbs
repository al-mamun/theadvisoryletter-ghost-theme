{{!-- One of four built-in marks for a record card, chosen by position.

     Used in two places: the record cards on the home page when they are
     assembled from Ghost pages, and the same cards' fallback when no record
     pages exist yet. Keeping the drawings here means the two branches cannot
     drift apart.

     A record page with its own feature image uses that instead; these are only
     what shows when there is no image. Call as:

         {{> "components/record-icon" n=@number}}   inside a {{#foreach}}
         {{> "components/record-icon" n=1}}         fixed position
--}}
{{#match n "=" 1}}
    {{!-- Searchable records: a table with a magnifier over it --}}
    <svg class="tal-data-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
        <rect x="3" y="5" width="26" height="22" rx="2.5" stroke="currentColor" stroke-width="1.6"/>
        <path d="M3 12h26M12 12v15" stroke="currentColor" stroke-width="1.6"/>
        <circle cx="20" cy="19" r="4" stroke="currentColor" stroke-width="1.6"/>
        <path d="m23 22 3.2 3.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
{{else match n "=" 2}}
    {{!-- Research and statistics: a bar chart --}}
    <svg class="tal-data-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
        <path d="M4 27h24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        <rect x="6" y="16" width="5" height="8" rx="1" stroke="currentColor" stroke-width="1.6"/>
        <rect x="14" y="10" width="5" height="14" rx="1" stroke="currentColor" stroke-width="1.6"/>
        <rect x="22" y="5" width="5" height="19" rx="1" stroke="currentColor" stroke-width="1.6"/>
    </svg>
{{else match n "=" 3}}
    {{!-- Annual report analysis: a document with a folded corner --}}
    <svg class="tal-data-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
        <path d="M7 4h12l6 6v18a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        <path d="M19 4v6h6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        <path d="M11 17h10M11 22h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
{{else}}
    {{!-- Request log, and the mark for any further card: a file folder --}}
    <svg class="tal-data-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
        <path d="M4 9a2 2 0 0 1 2-2h6.6l2.4 3H26a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        <path d="M10 17h12M10 21h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
{{/match}}
